# ─── App ───────────────────────────────────────────────────────────────────────
# Docker Compose supplies NEXT_PUBLIC_APP_URL from APP_URL.
APP_URL=http://localhost:3000
LINKA_INTERNAL_MODE=true
BETTER_AUTH_URL=http://localhost:3000

# ─── Database (Docker Compose) ─────────────────────────────────────────────────
# Docker Compose uses SQLite at file:/app/data/app.db, persisted in ./data.
# Do not set DATABASE_URL for the Compose deployment.

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret
# Required only while the database is first created. Store a unique password here;
# it is never logged by the container. These values do not reset an existing admin.
INITIAL_ADMIN_EMAIL=admin@linka.test
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password

# ─── Optional integrations (leave blank to disable) ────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_BUSINESS_MONTHLY=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LINKA by CYREX Technologies <noreply@localhost>

# ─── Wallets (optional; uncomment and set every listed value to enable) ────────
# APPLE_WALLET_CERT=
# APPLE_WALLET_KEY=
# APPLE_WALLET_WWDR=
# APPLE_TEAM_ID=
# APPLE_PASS_TYPE_ID=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT=
